{
  "name": "changesets-gitea-action",
  "version": "0.1.0",
  "description": "An action to automate releases with Changesets for Gitea repositories",
  "repository": {
    "type": "git",
    "url": "https://github.com/anytinz/changesets-gitea-action.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "action.yaml"
  ],
  "scripts": {
    "build": "tsdown",
    "changeset": "changeset",
    "gitea:types": "node scripts/generate-gitea-schema.js",
    "lint": "eslint --cache --concurrency 8 .",
    "prepare": "pnpm gitea:types",
    "release": "pnpm changeset publish",
    "test": "vitest run",
    "test:type": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/artifact": "6.2.1",
    "@actions/core": "3.0.1",
    "@actions/exec": "3.0.0",
    "@actions/github": "9.1.1",
    "@changesets/get-release-plan": "5.0.0",
    "@changesets/git": "4.0.0",
    "@changesets/pre": "3.0.0",
    "@changesets/read": "1.0.0",
    "@manypkg/get-packages": "3.1.0",
    "human-id": "4.2.0",
    "markdown-table": "3.0.4",
    "openapi-fetch": "0.17.0",
    "semver": "7.8.5",
    "tinyexec": "1.3.0"
  },
  "devDependencies": {
    "@anytinz/eslint-config": "2.7.1",
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@changesets/types": "7.0.0",
    "@changesets/write": "1.0.0",
    "@types/node": "24.13.3",
    "@types/semver": "7.8.0",
    "better-typescript-lib": "2.12.0",
    "eslint": "9.39.5",
    "fs-fixture": "2.14.0",
    "openapi-typescript": "7.13.0",
    "tsdown": "0.22.14",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "^22.11 || ^24.11 || >=26"
  }
}
